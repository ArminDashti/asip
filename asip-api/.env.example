PORT=3000

# Docker Compose (optional host publishing; leave empty behind nginx/sslh)
# API_PUBLISH_PORT=3000
# DOCKER_NETWORK=asip-net

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=as_ip
DB_SSLMODE=disable

GIN_MODE=debug

# Comma-separated browser origins allowed to call the API (gin-contrib/cors).
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://asip.xaigrok.ir

# Data sync (purge + import latest IPs only)
SYNC_ENABLED=true
SYNC_ON_STARTUP=false
SYNC_HOUR_UTC=2
SYNC_INTERVAL_DAYS=5

REPO_AS_METADATA_PATH=C:\Users\armin\Documents\GitHub\as-metadata
REPO_AS_IP_BLOCKS_PATH=C:\Users\armin\Documents\GitHub\as-ip-blocks
REPO_GEO_IP_BLOCKS_PATH=C:\Users\armin\Documents\GitHub\geo-ip-blocks

REPO_AS_METADATA_URL=https://github.com/ipverse/as-metadata
REPO_AS_IP_BLOCKS_URL=https://github.com/ipverse/as-ip-blocks
REPO_GEO_IP_BLOCKS_URL=https://github.com/ipverse/geo-ip-blocks
